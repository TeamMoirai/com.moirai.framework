<#@ template language="C#" #>
<#@ output extension=".cs" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#
    // n=0: non-generic Format(string format)
    // n=1..16: generic Format<T1..Tn>(string format, T1 arg1, ..., Tn argn)
    //
    // This template generates TWO partial type definitions in one output file:
    //   1. StringUtility — static Format facade methods (n=0..16)
    //   2. StringHandler.IStringBuilder — partial interface declaring Format overloads (n=0..16)
    // Keeping them in one template ensures the overload sets always stay in sync.
#>
// <auto-generated>
//     Generated by StringUtility.Format.tt.
//     Do not modify directly — edit the template and regenerate.
// </auto-generated>

using JetBrains.Annotations;

namespace Moirai.Atropos
{
    public static partial class StringUtility
    {
        /// <summary>
        /// 格式化字符串。format 为 null 时抛出 <see cref="GameException"/>。
        /// </summary>
        [StringFormatMethod("format")]
        public static string Format(string format)
        {
            if (format == null)
            {
                throw new GameException("Format is invalid.");
            }

            var sb = CreateStringBuilder();
            try
            {
                return sb.Format(format);
            }
            finally
            {
                sb.Dispose();
            }
        }

<#
    for (int n = 1; n <= 16; n++)
    {
        string tp = "<" + string.Join(", ", Enumerable.Range(1, n).Select(i => "T" + i)) + ">";
        string fp = "string format, " + string.Join(", ", Enumerable.Range(1, n).Select(i => "T" + i + " arg" + i));
        string fa = "format, " + string.Join(", ", Enumerable.Range(1, n).Select(i => "arg" + i));
#>
        /// <summary>
        /// 格式化字符串。format 为 null 时抛出 <see cref="GameException"/>。
        /// </summary>
        [StringFormatMethod("format")]
        public static string Format<#= tp #>(<#= fp #>)
        {
            if (format == null)
            {
                throw new GameException("Format is invalid.");
            }

            var sb = CreateStringBuilder();
            try
            {
                return sb.Format(<#= fa #>);
            }
            finally
            {
                sb.Dispose();
            }
        }

<#
    }
#>
    }

    public abstract partial class StringHandler
    {
        /// <summary>
        /// 格式化方法（partial）。由 T4 模板统一生成，确保与 <see cref="StringUtility"/> 的 Format 重载保持同步。
        /// </summary>
        public partial interface IStringBuilder
        {
            /// <summary>
            /// 格式化字符串并返回结果。
            /// </summary>
            string Format(string format);

<#
    for (int n = 1; n <= 16; n++)
    {
        string tp = "<" + string.Join(", ", Enumerable.Range(1, n).Select(i => "T" + i)) + ">";
        string fp = "string format, " + string.Join(", ", Enumerable.Range(1, n).Select(i => "T" + i + " arg" + i));
#>
            /// <summary>
            /// 格式化字符串并返回结果。
            /// </summary>
            string Format<#= tp #>(<#= fp #>);

<#
    }
#>
        }
    }
}
